# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  ChurchForce — Development Environment                                  ║
# ║  Copy to .env before running: cp .env.dev .env                         ║
# ║  NEVER commit .env to git. This file IS safe to commit (.env.dev).     ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Django Core ───────────────────────────────────────────────────────────────
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=goodnewsonlygoodnewsalways

MARKETING_DOMAIN=churchforce.localhost
APP_DOMAIN=workforce.localhost:8000
FOUNDER_SUBDOMAIN=founder

# Hosts that Django will serve — add your LAN IP if testing on mobile
ALLOWED_HOSTS=localhost,127.0.0.1,churchforce.localhost,workforce.localhost,*.localhost

# CSRF must match the origin your browser sends
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001

# ── Local Database ────────────────────────────────────────────────────────────
# Settings reads DB_NAME/USER/PASSWORD/HOST/PORT in development mode.
# To wipe and start fresh: bash scripts/reset_dev_db.sh
DB_NAME=churchforce_dev
DB_USER=postgres
DB_PASSWORD=goodnewsonlygoodnewsalways
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Redis (install: brew install redis  OR  sudo apt install redis-server)
# Start: redis-server  (or it runs as a system service automatically)
REDIS_URL=redis://127.0.0.1:6379/0

# ── Cloudinary ────────────────────────────────────────────────────────────────
# In dev, Django uses local FileSystemStorage (DEFAULT_FILE_STORAGE is not
# set to Cloudinary unless DEBUG=False), but the credentials must still be
# present for the cloudinary.config() call in settings.py.
CLOUDINARY_CLOUD_NAME=dahx6bbyr
CLOUDINARY_API_KEY=965118234472911
CLOUDINARY_API_SECRET=EtuLzVQT9ngLvtxgh8uYoyMBelE
CLOUDINARY_URL=cloudinary://965118234472911:EtuLzVQT9ngLvtxgh8uYoyMBelE@dahx6bbyr

# ── VAPID / Web Push ──────────────────────────────────────────────────────────
# Push notifications won't actually deliver in dev (no HTTPS), but the key
# must be present to avoid the VAPID_PUBLIC_KEY meta tag being blank.
VAPID_PUBLIC_KEY=BLUgKD1EFgvfKJcIl1BIkCDcWjAiOkDP7KCWZUWHS8ZVhqKK96IIGsI0Ce7NzLa97AApDaYyw9bzOl69FMahRWY
VAPID_PRIVATE_KEY=MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgipOtHI2d1ZhZuVZQRcz8th_KTvAJetAxQ1epJ2wev1GhRANCAAS1ICg9RBYL3yiXCJdQSJAg3FowIjpAz-yglmVFh0vGVYaiiveiCBrCNAnuzcy2vewAKQ2mMsPW8zpevRTGoUVm
VAPID_ADMIN_EMAIL=admin@localhost

# ── Paystack ─────────────────────────────────────────────────────────────────
# Use Paystack TEST keys in dev — no real charges
PAYSTACK_SECRET_KEY=sk_test_your_test_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_test_key_here

# ── SMS (Termii) ──────────────────────────────────────────────────────────────
# Set SMS_PROVIDER=stub in dev so SMS calls are logged but not actually sent
SMS_PROVIDER=stub
TERMII_API_KEY=
TERMII_SENDER_ID=ChurchForce

# ── Music API ─────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
FLAT_API_TOKEN=
OPENAI_API_KEY=

# ── PWA ───────────────────────────────────────────────────────────────────────
PWA_APP_NAME="ChurchForce Dev"
PWA_SHORT_NAME="CF Dev"

# ── White-label DB routing ────────────────────────────────────────────────────
# Add entries here for any white-label orgs you want to test locally.
# Pattern: WL_DB_URL_<SLUG_UPPERCASE>=postgres://...
# Example:
# WL_DB_URL_GRACE_CHAPEL=postgresql://postgres:password@localhost:5432/grace_chapel_dev

# ── Demo church (optional) ───────────────────────────────────────────────────
# Set to enable nightly demo reset via APScheduler.
# Run once: python manage.py seed_demo --subdomain demo
DEMO_SUBDOMAIN=demo
DEMO_PASSWORD=Demo@1234

# ── AI Provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

